<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>PulseTrack.Taskbar.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Company>PulseTrack</Company>
    <Description>Foreground stopwatch on the Windows taskbar</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.*" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="PulseTrack.Taskbar.Tests/**/*.cs" />
  </ItemGroup>
</Project>
